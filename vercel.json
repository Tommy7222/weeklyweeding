
{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/success",
      "destination": "/public/success.html"
    },
    {
      "source": "/success/(.*)",
      "destination": "/public/success.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ]
}
